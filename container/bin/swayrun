#!/usr/bin/env bash
# swayrun APP [ARGS]  launch an app inside the sway desktop
[ $# -gt 0 ] || { echo "usage: swayrun APP [ARGS]" >&2; exit 1; }
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg-$(id -u)}"
SWAYSOCK="$(ls "$XDG_RUNTIME_DIR"/sway-ipc.* 2>/dev/null | head -1)"
[ -n "$SWAYSOCK" ] || { echo "sway not running: wayland-browser start" >&2; exit 1; }
export SWAYSOCK
swaymsg -q exec "$(printf '%q ' "$@")" && echo .
